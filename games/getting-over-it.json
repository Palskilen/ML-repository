{
  "schema": 2,
  "id": "getting-over-it",
  "name": "Getting Over It with Bennett Foddy",
  "steam": 240720,
  "developer": "Bennett Foddy",
  "links": {
    "steam": "https://store.steampowered.com/app/240720/",
    "website": "https://www.foddy.net/"
  },

  "cheats": {
    "gravity": {
      "name": "Niska grawitacja",
      "desc": "Zmienia grawitację w grze. Normalna wartość to 30, mniej = lżejszy lot.",
      "icon": "moon",
      "bind": "F6",
      "value": { "min": 0, "max": 30, "step": 0.5, "default": 10, "unit": " m/s²" }
    },
    "checkpoint": {
      "name": "Checkpoint",
      "desc": "Jeden checkpoint: pozycja, młotek i kamera. W grze widać go z daleka jako znacznik, a w apce i na overlayu status.",
      "icon": "pin",
      "bind": "F7",
      "actions": [
        { "id": "set", "name": "Postaw checkpoint", "bind": "G" },
        { "id": "tp", "name": "Teleportuj do checkpointa", "bind": "T" }
      ]
    },
    "minimap": {
      "name": "Minimapa",
      "desc": "Podgląd mapy w rogu ekranu oraz pełna mapa: zaznacz miejsce i teleportuj się. Teleport w strefę końca gry jest zablokowany.",
      "icon": "map",
      "bind": "F9",
      "value": { "min": 30, "max": 160, "step": 5, "default": 70, "unit": " m" },
      "actions": [
        { "id": "open", "name": "Otwórz pełną mapę", "bind": "M" }
      ]
    },
    "glue": {
      "name": "Klej",
      "desc": "Przyklej młotek albo postać do powierzchni (jedno odkleja drugie) i „chodź” po ścianie.",
      "icon": "link",
      "bind": "F10",
      "actions": [
        { "id": "hammer", "name": "Przyklej / odklej młotek", "bind": "Q" },
        { "id": "body", "name": "Przyklej / odklej postać", "bind": "E" },
        { "id": "release", "name": "Odklej wszystko", "bind": "X" }
      ]
    }
  },

  "setup": {
    "engine": "unity-mono",
    "arch": "x64",
    "exe": "GettingOverIt.exe",
    "inject": {
      "payload": "plugins/getting-over-it/payload.dll",
      "namespace": "MLTester",
      "class": "Loader",
      "method": "Init"
    },
    "launch": { "via": "steam" }
  }
}
